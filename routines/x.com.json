  "speedupSummary": "SPA timeline navigation via domcontentloaded + 350 ms hydration + 80 ms submit settle; Cloudflare wall auto-detected for instant browser_handoff",
  "accessProfile": {
    "preferredWaitUntil": "domcontentloaded",

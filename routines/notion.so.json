    "read_page": {
      "name": "read_page",
      "description": "Extracts clean Notion document blocks and database rows from .notion-page-content / main in ~50 ms.",
      "readOnly": true,
      "verifiedAt": "2026-11-17T17:35:00Z",
      "updatedAt": "2026-11-17T17:35:00Z",
      "params": {},
      "steps": [
        {
          "op": "query",
          "params": {
            "operation": "innerText",
            "maxChars": 60000,
            "locator": {
              "steps": [
                { "kind": "css", "value": ".notion-page-content, main, .notion-frame" },
                { "kind": "nth", "index": 0 }

      "verifiedAt": "2026-11-17T17:35:00Z",
      "updatedAt": "2026-11-17T17:35:00Z",
      "params": {
        "query": { "type": "string", "description": "Workspace page title or search keywords.", "required": true }
      },
      "steps": [
        {
          "op": "press",
          "params": { "key": "Control+k" },
          "optional": false
        },
        {
          "op": "type",
          "params": {
            "text": "{{query}}",
            "clear": true,
            "locator": {
              "steps": [

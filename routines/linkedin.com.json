  "routines": {
    "search_jobs": {
      "name": "search_jobs",
      "description": "Searches LinkedIn Jobs by keywords and optional location, returning clean job listings from <main>.",
      "readOnly": false,
      "verifiedAt": "2026-11-17T17:35:00Z",
      "updatedAt": "2026-11-17T17:35:00Z",
      "params": {
        "keywords": { "type": "string", "description": "Job title, skill, or company keywords.", "required": true },
        "location": { "type": "string", "description": "Optional city/region/Remote.", "required": false, "default": "" }
      },
      "steps": [
        {
          "op": "navigate",
          "params": {
            "url": "https://www.linkedin.com/jobs/search/?keywords={{keywords:urlencode}}&location={{location:urlencode}}",
            "waitUntil": "domcontentloaded"
          },
          "optional": false
        },
        {
          "op": "click",
          "params": {
            "timeoutMs": 600,
            "locator": {
              "steps": [
                { "kind": "css", "value": "button.contextual-sign-in-modal__modal-dismiss, button[aria-label='Dismiss']" },
                { "kind": "nth", "index": 0 }
              ]
            }
          },
          "optional": true
        },
        {
          "op": "query",
          "params": {
            "operation": "innerText",
            "maxChars": 45000,
            "locator": {
              "steps": [
                { "kind": "css", "value": "main, #main-content" },
                { "kind": "nth", "index": 0 }
              ]
            }
          },
          "saveAs": "jobs",
          "optional": false
        }
      ]
    },
    "search_people": {
      "name": "search_people",
      "description": "Searches LinkedIn People inside your signed-in session and snapshots matching profiles.",
      "readOnly": false,
      "verifiedAt": "2026-11-17T17:35:00Z",
      "updatedAt": "2026-11-17T17:35:00Z",
      "params": {
        "keywords": { "type": "string", "description": "Person name, role, or company.", "required": true }
      },
      "steps": [
        {
          "op": "navigate",
          "params": {
            "url": "https://www.linkedin.com/search/results/people/?keywords={{keywords:urlencode}}",
            "waitUntil": "domcontentloaded"
          },
          "optional": false
        },
        {
          "op": "snapshot",
          "params": { "maxChars": 18000 },
          "saveAs": "people",
          "optional": false
        }
      ]

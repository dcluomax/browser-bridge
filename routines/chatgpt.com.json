  "routines": {
    "draft_prompt": {
      "name": "draft_prompt",
      "description": "Fills ChatGPT's composer textbox ('Chat with ChatGPT' / #prompt-textarea) without clicking Send so the user or agent can review first.",
      "readOnly": false,
      "verifiedAt": "2026-11-17T09:45:00Z",
      "updatedAt": "2026-11-17T09:45:00Z",
      "params": {
        "prompt": {
          "type": "string",
          "description": "Prompt text to stage in the composer.",
          "required": true
        }
      },
      "steps": [
        {
          "op": "type",
          "params": {
            "text": "{{prompt}}",
            "clear": true,
            "submit": false,
            "locator": {
              "steps": [
                { "kind": "css", "value": "#prompt-textarea, textarea[name='prompt-textarea'], form textarea, [contenteditable='true']#prompt-textarea" },
                { "kind": "nth", "index": 0 }
              ]
            }
          },
          "optional": false
        }
      ]
    },
    "ask_and_wait": {
      "name": "ask_and_wait",
      "description": "Submits a prompt in ChatGPT, waits deterministically for token streaming to complete (Stop button hidden), and returns the conversation text in outputs.reply.",
      "readOnly": false,
      "verifiedAt": "2026-11-17T09:45:00Z",
      "updatedAt": "2026-11-17T09:45:00Z",
      "params": {
        "prompt": {
          "type": "string",
          "description": "Prompt to send to ChatGPT.",
          "required": true
        }
      },
      "steps": [
        {
          "op": "type",
          "params": {
            "text": "{{prompt}}",
            "clear": true,
            "submit": false,
            "locator": {
              "steps": [
                { "kind": "css", "value": "#prompt-textarea, textarea[name='prompt-textarea'], form textarea" },
                { "kind": "nth", "index": 0 }
              ]
            }
          },
          "optional": false
        },
        {
          "op": "click",
          "params": {
            "locator": {
              "steps": [
                { "kind": "css", "value": "button[data-testid='send-button'], button[aria-label='Send message'], button[aria-label='Send prompt']" },
                { "kind": "nth", "index": 0 }
              ]
            }
          },
          "optional": false
        },
        {
          "op": "waitFor",
          "params": {
            "seconds": 0.6,
            "timeoutSeconds": 5
          },
          "optional": true
        },
        {
          "op": "waitFor",
          "params": {
            "state": "hidden",
            "timeoutSeconds": 120,
            "locator": {
              "steps": [
                { "kind": "css", "value": "button[data-testid='stop-button'], button[aria-label*='Stop']" },
                { "kind": "nth", "index": 0 }
              ]
            }
          },
          "optional": true
        },
        {
          "op": "query",
          "params": {
            "operation": "innerText",
            "maxChars": 60000,
            "locator": {
              "steps": [
                { "kind": "css", "value": "main" },
                { "kind": "nth", "index": 0 }
              ]
            }
          },
          "saveAs": "reply",
          "optional": false
        }
      ]
    },

  "speedupSummary": "Page ready in ~865 ms via domcontentloaded + 35 ms snapshot; ProseMirror contenteditable draft staging + deterministic Stop-button streaming wait",
  "accessProfile": {
    "preferredWaitUntil": "domcontentloaded",
    "hydrationSettleMs": 200,
    "readinessQuietMs": 65,
    "readinessSelector": "div.ProseMirror[contenteditable='true'], fieldset [contenteditable='true'], main",
    "preferredSnapshotFrames": "top",
    "actionSettleMs": 60,
    "submitSettleMs": 80,
    "dynamicDom": true,
    "directHttpBlocked": true,
